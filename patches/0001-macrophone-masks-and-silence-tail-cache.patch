+void whisper_macrophone_set_live(struct whisper_context * ctx, int n_live, int mode) {
+    if (ctx->state == nullptr) {
+        return;
+    }
+    const int n_ctx = ctx->model.hparams.n_audio_ctx;
+    ctx->state->macrophone_live      = (n_live > 0 && n_live < n_ctx && ctx->params.flash_attn) ? n_live : 0;
+    ctx->state->macrophone_tail_mode = mode;
+}
+
+void whisper_macrophone_set_draft(struct whisper_context * ctx, const whisper_token * tokens, int n_tokens) {
+    if (ctx->state == nullptr) {
+        return;
+    }
+    auto & st = *ctx->state;
+    st.macrophone_draft.assign(tokens, tokens + std::max(0, n_tokens));
+    st.macrophone_spec_rows     = 0;
+    st.macrophone_spec_row      = 0;
+    st.macrophone_spec_accepted = 0;
+    st.macrophone_spec_batches  = 0;
+}
+
+void whisper_macrophone_draft_stats(struct whisper_context * ctx, int * accepted, int * batches) {
+    if (ctx->state == nullptr) {
+        return;
+    }
+    *accepted = ctx->state->macrophone_spec_accepted;
+    *batches  = ctx->state->macrophone_spec_batches;
+}
+
+void whisper_macrophone_set_f16_act_min(struct whisper_context * ctx, int n_frames) {
+    if (ctx->state != nullptr) {
+        ctx->state->macrophone_f16_act_min = n_frames;
+    }
+}
