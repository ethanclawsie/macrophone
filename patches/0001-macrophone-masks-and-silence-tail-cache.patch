+// [macrophone] Copy/convert between two contiguous tensors: 4 elements per thread with vector loads, no
+// per-element index decomposition. kernel_cpy_t_t does 64-bit div/mod chains for every element, which
+// makes large contiguous casts (e.g. Whisper's per-layer K/V to F16) ALU-bound at ~15 GB/s.
+template<typename T0, typename T0_4, typename T1, typename T1_4>
+kernel void kernel_cpy_flat(
+        constant ggml_metal_kargs_cpy_flat & args,
+        device  const char * src0,
+        device        char * dst,
+        uint tid [[thread_position_in_grid]]) {
+    const int64_t i4 = tid;
+    const int64_t n4 = args.n/4;
+    if (i4 < n4) {
+        ((device T1_4 *) dst)[i4] = (T1_4) ((device const T0_4 *) src0)[i4];
+    } else if (i4 == n4) {
+        for (int64_t i = 4*n4; i < args.n; ++i) {
+            ((device T1 *) dst)[i] = (T1) ((device const T0 *) src0)[i];
+        }
+    }
+}
+
+typedef decltype(kernel_cpy_flat<float, float4, half, half4>) kernel_cpy_flat_t;
+
+template [[host_name("kernel_cpy_flat_f32_f32")]] kernel kernel_cpy_flat_t kernel_cpy_flat<float, float4, float, float4>;
+template [[host_name("kernel_cpy_flat_f32_f16")]] kernel kernel_cpy_flat_t kernel_cpy_flat<float, float4, half,  half4>;
+template [[host_name("kernel_cpy_flat_f16_f16")]] kernel kernel_cpy_flat_t kernel_cpy_flat<half,  half4,  half,  half4>;
+template [[host_name("kernel_cpy_flat_f16_f32")]] kernel kernel_cpy_flat_t kernel_cpy_flat<half,  half4,  float, float4>;
+
