+// [macrophone] silence-tail cache API (see macrophone_live in whisper_state)
+
+int whisper_macrophone_init_tail(struct whisper_context * ctx, float mel_peak, int n_threads) {
+    whisper_state * state = ctx->state;
+    if (state == nullptr || !ctx->params.flash_attn || mel_peak == 0.0f) {
+        return -1;
+    }
+
+    const auto & hp = ctx->model.hparams;
+    const int n_ctx = hp.n_audio_ctx;
+    const int n_pad = GGML_PAD(n_ctx, 256);
+
+    if (state->macrophone_cache_buf == nullptr) {
+        struct ggml_init_params params = {
+            /*.mem_size   =*/ 4*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        state->macrophone_cache_ctx = ggml_init(params);
+
+        state->macrophone_enc_k   = ggml_new_tensor_1d(state->macrophone_cache_ctx, state->kv_pad.k->type, (int64_t) hp.n_audio_state*n_pad*hp.n_audio_layer);
+        state->macrophone_enc_v   = ggml_new_tensor_1d(state->macrophone_cache_ctx, state->kv_pad.v->type, (int64_t) hp.n_audio_state*n_pad*hp.n_audio_layer);
+        state->macrophone_cross_k = ggml_new_tensor_1d(state->macrophone_cache_ctx, state->kv_cross.k->type, ggml_nelements(state->kv_cross.k));
+        state->macrophone_cross_v = ggml_new_tensor_1d(state->macrophone_cache_ctx, state->kv_cross.v->type, ggml_nelements(state->kv_cross.v));
+
+        state->macrophone_cache_buf = ggml_backend_alloc_ctx_tensors(state->macrophone_cache_ctx, state->backends[0]);
+        if (state->macrophone_cache_buf == nullptr) {
+            WHISPER_LOG_ERROR("%s: failed to allocate the silence-tail cache\n", __func__);
+            return -2;
+        }
+        ggml_backend_buffer_clear(state->macrophone_cache_buf, 0);
+
+        WHISPER_LOG_INFO("%s: silence-tail cache = %7.2f MB\n", __func__, ggml_backend_buffer_get_size(state->macrophone_cache_buf)/1e6);
+    }
+
+    state->macrophone_mel_peak = mel_peak;
+
+    // a full window of digital silence: after normalization every value is the floor
+    const float silence = (mel_peak - 8.0f + 4.0f)/4.0f;
+
+    state->mel.n_mel     = hp.n_mels;
+    state->mel.n_len     = 2*n_ctx;
+    state->mel.n_len_org = 2*n_ctx;
+    state->mel.data.assign((size_t) hp.n_mels*2*n_ctx, silence);
+
+    const int saved_exp = state->exp_n_audio_ctx;
+    state->exp_n_audio_ctx = 0;
+    state->macrophone_capture   = true;
+
+    const bool ok = whisper_encode_internal(*ctx, *state, 0, n_threads, nullptr, nullptr);
+
+    state->macrophone_capture   = false;
+    state->exp_n_audio_ctx = saved_exp;
+
+    return ok ? 0 : -3;
+}
