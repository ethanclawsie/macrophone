diff --git a/ggml/src/ggml-metal/ggml-metal-fusion.cpp b/ggml/src/ggml-metal/ggml-metal-fusion.cpp
index d78ca7c..debe246 100644
--- a/ggml/src/ggml-metal/ggml-metal-fusion.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-fusion.cpp
@@ -706,6 +706,128 @@ static bool ggml_metal_fusion_check_mul_mat_add(
         (add->data == res->data || !ggml_metal_fusion_overlap(add, res));
 }
 
+// [macrophone] single-row q4_0 mat-vec + up to two same-length F32 addends (bias, residual) or one addend + GELU,
+// applied by kernel_mul_mv_q4_0_f32_epi as it writes each output element. A decoder step is a chain of tiny
+// dependent kernels whose launch latency dominates; this removes ~10 of them per Whisper decoder layer.
+static const ggml_tensor * ggml_metal_epi_addend(const ggml_tensor * prev, const ggml_tensor * add) {
+    if (add->op != GGML_OP_ADD || (add->src[0] == prev) == (add->src[1] == prev)) {
+        return NULL;
+    }
+    const ggml_tensor * other = add->src[0] == prev ? add->src[1] : add->src[0];
+    const bool ok = other->type == GGML_TYPE_F32 && add->type == GGML_TYPE_F32 && ggml_is_contiguous(other) &&
+        ggml_nelements(other) == prev->ne[0] && ggml_are_same_shape(add, prev);
+    return ok ? other : NULL;
+}
+
+// set by the device init: the tensor-API kernel_mul_mm implements the epilogue, the simdgroup one does not
+extern "C" bool g_ggml_metal_macrophone_mm_epi;
+bool g_ggml_metal_macrophone_mm_epi = false;
+
+static bool ggml_metal_fusion_check_mul_mat_epi_mm(const ggml_metal_fusion * fusion, const ggml_tensor * const * nodes,
+                                                  ggml_metal_fusion_mode mode) {
+    const ggml_tensor * mm = nodes[0];
+    const bool ok = g_ggml_metal_macrophone_mm_epi &&
+        // below a few hundred columns the extra per-element epilogue work costs more than the passes it saves
+        mm->type == GGML_TYPE_F32 && mm->src[1]->ne[1] >= 384 && mm->src[0]->ne[0] >= 64 &&
+        mm->src[1]->ne[2] == 1 && mm->src[1]->ne[3] == 1 && mm->src[0]->ne[2] == 1 && mm->src[0]->ne[3] == 1 &&
+        !ggml_is_transposed(mm->src[0]) && !ggml_is_transposed(mm->src[1]) && ggml_is_contiguous(mm);
+    if (!ok) {
+        return false;
+    }
+
+    // first ADD: a bias row broadcast over the columns
+    const ggml_tensor * a = nodes[1];
+    if (a->op != GGML_OP_ADD || (a->src[0] == mm) == (a->src[1] == mm) || a->type != GGML_TYPE_F32 || !ggml_are_same_shape(a, mm)) {
+        return false;
+    }
+    const ggml_tensor * bias = a->src[0] == mm ? a->src[1] : a->src[0];
+    if (bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) || ggml_nelements(bias) != mm->ne[0]) {
+        return false;
+    }
+
+    const int n = (int) fusion->ops.size();
+    const ggml_tensor * res = NULL;
+    if (n == 3) {
+        const ggml_tensor * last = nodes[2];
+        if (last->op == GGML_OP_ADD) {
+            if ((last->src[0] == a) == (last->src[1] == a)) {
+                return false;
+            }
+            res = last->src[0] == a ? last->src[1] : last->src[0];
+            if (res->type != GGML_TYPE_F32 || !ggml_are_same_shape(res, mm) || !ggml_is_contiguous(res) || last->type != GGML_TYPE_F32) {
+                return false;
+            }
+        } else if (last->op != GGML_OP_UNARY || ggml_get_unary_op(last) != GGML_UNARY_OP_GELU ||
+                   last->src[0] != a || last->type != GGML_TYPE_F32 || !ggml_is_contiguous(last)) {
+            return false;
+        }
+    }
+
+    if (mode == GGML_METAL_FUSION_STRUCTURAL) {
+        return true;
+    }
+
+    const ggml_tensor * dst = nodes[n - 1];
+    return !ggml_metal_fusion_overlap(dst, mm->src[0]) && !ggml_metal_fusion_overlap(dst, mm->src[1]) &&
+        !ggml_metal_fusion_overlap(dst, bias) && (res == NULL || res->data == dst->data || !ggml_metal_fusion_overlap(dst, res));
+}
+
+static bool ggml_metal_fusion_check_mul_mat_epi(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+
+    if (nodes[0]->src[1]->ne[1] > 8) {
+        return ggml_metal_fusion_check_mul_mat_epi_mm(fusion, nodes, mode);
+    }
+
+    const ggml_tensor * mm = nodes[0];
+    const bool mv = mm->src[0]->type == GGML_TYPE_Q4_0 && mm->src[1]->type == GGML_TYPE_F32 && mm->type == GGML_TYPE_F32 &&
+        mm->src[1]->ne[1] == 1 && mm->src[1]->ne[2] == 1 && mm->src[1]->ne[3] == 1 &&
+        mm->src[0]->ne[2] == 1 && mm->src[0]->ne[3] == 1 &&
+        ggml_is_contiguous(mm->src[1]) && ggml_is_contiguous(mm) && !ggml_is_transposed(mm->src[0]);
+    if (!mv) {
+        return false;
+    }
+
+    const ggml_tensor * a0 = ggml_metal_epi_addend(mm, nodes[1]);
+    if (a0 == NULL) {
+        return false;
+    }
+
+    const int n = (int) fusion->ops.size();
+    const ggml_tensor * a1 = NULL;
+    if (n == 3) {
+        const ggml_tensor * last = nodes[2];
+        if (last->op == GGML_OP_ADD) {
+            a1 = ggml_metal_epi_addend(nodes[1], last);
+            if (a1 == NULL) {
+                return false;
+            }
+        } else if (last->op != GGML_OP_UNARY || ggml_get_unary_op(last) != GGML_UNARY_OP_GELU ||
+                   last->src[0] != nodes[1] || last->type != GGML_TYPE_F32 || !ggml_is_contiguous(last)) {
+            return false;
+        }
+    }
+
+    if (mode == GGML_METAL_FUSION_STRUCTURAL) {
+        return true;
+    }
+
+    // other threads keep reading the weights and the input vector while outputs are written; the addends are
+    // read by the thread that writes the same element, so an in-place addend is fine
+    const ggml_tensor * dst = nodes[n - 1];
+    return !ggml_metal_fusion_overlap(dst, mm->src[0]) && !ggml_metal_fusion_overlap(dst, mm->src[1]) &&
+        (a0->data == dst->data || !ggml_metal_fusion_overlap(dst, a0)) &&
+        (a1 == NULL || a1->data == dst->data || !ggml_metal_fusion_overlap(dst, a1));
+}
