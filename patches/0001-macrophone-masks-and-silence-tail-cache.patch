+// [macrophone] Decide how to get the logits for the next step of a single greedy decoder.
+// Returns true if it took care of it: either a precomputed row is valid (skip_decode = true), or it filled
+// state.batch with [last token, draft...] for one batched decode whose rows the next steps can reuse.
+static bool whisper_macrophone_spec_prepare(
+        whisper_state & state,
+        whisper_decoder & decoder,
+        const int n_past,
+        bool & skip_decode) {
+    skip_decode = false;
+
+    auto & draft = state.macrophone_draft;
+    if (draft.empty()) {
+        return false;
+    }
+
+    const auto & seq  = decoder.sequence.tokens;
+    const int    L    = (int) seq.size();
+    const auto   last = seq.back().id;
+
+    if (state.macrophone_spec_rows > 0) {
+        // the pending row was computed with draft[L - 1] as input: valid iff that's what was sampled
+        if (L - 1 < (int) draft.size() && last == draft[L - 1]) {
+            decoder.i_batch = state.macrophone_spec_row++;
+            state.macrophone_spec_rows--;
+            state.macrophone_spec_accepted++;
+            skip_decode = true;
+            return true;
+        }
+
+        // diverged: the cache holds unverified draft tokens from n_past on
+        whisper_kv_cache_seq_rm(state.kv_self, 0, n_past, -1);
+        state.macrophone_spec_rows = 0;
+        draft.clear();
+        return false;
+    }
+
+    // start a batched verification only while the sequence still matches the draft
+    if (L >= (int) draft.size()) {
+        return false;
+    }
+    for (int k = 0; k < L; ++k) {
+        if (seq[k].id != draft[k]) {
+            draft.clear();
+            return false;
+        }
+    }
+
+    auto & batch = state.batch;
+    const int n_draft = std::min((int) draft.size() - L, 128);
+
+    batch.n_tokens = 0;
+    for (int k = 0; k <= n_draft; ++k) {
+        batch.token   [batch.n_tokens]    = k == 0 ? last : draft[L + k - 1];
+        batch.pos     [batch.n_tokens]    = n_past + k;
+        batch.n_seq_id[batch.n_tokens]    = 1;
+        batch.seq_id  [batch.n_tokens][0] = 0;
+        batch.logits  [batch.n_tokens]    = 1;
+        batch.n_tokens++;
+    }
+
+    decoder.i_batch       = 0;
+    state.macrophone_spec_row  = 1;
+    state.macrophone_spec_rows = n_draft;
+    state.macrophone_spec_batches++;
+
+    return true;
+}
